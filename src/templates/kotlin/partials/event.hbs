        {{~#if (isSpecified this.defaultValue)}}{{#if (isRef this.defaultValue)}} = null{{else}} = {{>defaultValueFormat parameter=this}}{{/if}},{{else}},{{/if}}
        {{/each}}
        {{/filterUndefined}}
    ) {
        {{#filterDefined this.parameters 'defaultValue'}}
        {{#each this}}
        {{#if (isRef this.defaultValue)}}
        val _{{camelcase this.name}} = {{camelcase this.name}} ?: {{camelcase (extractRef this.defaultValue)}}.eventValue
        {{/if}}
        {{/each}}
        {{/filterDefined}}
        {{#if @root.disableSendingMeta}}
